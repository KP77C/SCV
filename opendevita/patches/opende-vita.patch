+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// Coarse frame-time breakdown for slow targets (PS Vita). Each Scope charges
+// the time spent inside it, minus nested scopes, to its section. On by
+// default on the Vita; DX_PROF=1 turns it on elsewhere.
+namespace dx::prof {
+    enum Section : uint8_t {
+        Other,
+        GameOther,
+        DrawOther,
+        TickActors,
+        Physics,
+        Movement,
+        Script,
+        AI,
+        Audio,
+        UI,
+        Visibility,
+        Sky,
+        Level,
+        Meshes,
+        MeshLights,
+        Sprites,
+        Translucent,
+        Canvas,
+        GLCalls,
+        Procedural,
+        Count
+    };
+
+    bool enabled();
+    uint64_t nowMicros();
+    // Average cost of one timer read, for judging the profiler's own overhead.
+    double timerCostMicros();
+
+    struct State {
+        Section current = Other;
+        uint64_t stamp = 0;
+        uint64_t total[Count] {};
+        uint32_t calls[Count] {};
+    };
+    State& state();
+
+    class Scope {
+    public:
+        explicit Scope(Section section)
+        {
+            if (!enabled()) {
+                active = false;
+                return;
+            }
+            State& s = state();
+            uint64_t t = nowMicros();
+            s.total[s.current] += t - s.stamp;
+            s.stamp = t;
+            previous = s.current;
+            s.current = section;
+            s.calls[section]++;
+        }
+        ~Scope()
+        {
+            if (!active) {
+                return;
+            }
+            State& s = state();
+            uint64_t t = nowMicros();
+            s.total[s.current] += t - s.stamp;
+            s.stamp = t;
+            s.current = previous;
+        }
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+
+    private:
+        bool active = true;
+        Section previous = Other;
+    };
+
+    // Per-frame averages of the busiest sections since the last report, as
+    // one line; resets the counters.
+    std::string report(uint32_t frames);
+}
