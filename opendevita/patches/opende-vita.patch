+// PS Vita version of UberShader (render/gl_shader.h).
+//
+// The PC build draws everything with one GLSL program that tests uFlags for
+// every pixel. The Vita GPU (SGX543) pays for every one of those branches, so
+// here each combination of flags the renderer actually uses gets its own small
+// Cg program with only the code it needs, built the first time it is drawn.
+// The dynamic light count is part of the key too, so the light loop is
+// unrolled. Differences from the PC shader, on purpose:
+//   * lightmaps use plain bilinear filtering (no bicubic "smooth lightmaps"),
+//   * no ambient occlusion mask output (the Vita build has no AO pass),
+//   * colour maths in half precision,
+//   * clip planes (mirrors, portals) are hardware clip outputs, max 7.
+#ifdef __vita__
+
+#include "render/gl_shader.h"
+#include "core/prof.h"
+
+#include <glad/gl.h>
+
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+namespace dx {
+    namespace {
+        constexpr int32_t KeyClip = 256;
+        constexpr int32_t KeyLightShift = 9;
+
+        const char* vertexCg = R"(
+void main(
+    float3 aPosition,
+    float2 aUV,
+    float2 aLightUV,
+    float4 aColor,
+    float3 aNormal,
+    float3 aFog,
+    uniform float4x4 uViewProj,
+    uniform float2 uPan,
+    uniform float2 uScale,
+    uniform float4 uEye,
+    uniform float4 uForward,
+#if CLIP
+    uniform float4 uClipPlanes[8],
+    float out vClip[7] : CLP0,
+#endif
+#if LIGHTS > 0
+    float3 out vWorld : TEXCOORD3,
+    float3 out vNormal : TEXCOORD4,
+#endif
+    float2 out vUV : TEXCOORD0,
+    float2 out vLightUV : TEXCOORD1,
+    half3 out vFog : TEXCOORD2,
+    half4 out vColor : COLOR,
+    float4 out gl_Position : POSITION)
+{
+    float4 position = float4(aPosition, 1.0);
+    vUV = aUV * uScale + uPan;
+    vLightUV = aLightUV;
+    vFog = aFog;
+#if DETAIL
+    float depth = dot(aPosition - uEye.xyz, uForward.xyz);
+    float distance = uForward.w;
+    float fade = floor((1.0 - clamp(depth, 0.0, distance) / distance) * 128.0 + 0.5) / 255.0;
+    vColor = half4(0.50196, 0.50196, 0.50196, fade);
+#else
+    vColor = aColor;
+#endif
+#if LIGHTS > 0
+    vWorld = aPosition;
+    vNormal = aNormal;
+#endif
+#if CLIP
+    for (int i = 0; i < 7; i++)
+    {
+        vClip[i] = dot(uClipPlanes[i], position);
+    }
+#endif
+    gl_Position = mul(position, uViewProj);
+}
+)";
+
+        const char* fragmentCg = R"(
+uniform float4 uTint;
+#if LIGHTS > 0
+uniform float4 uLights[24];
+
+half3 dynamicLight(float3 world, float3 normalIn)
+{
+    half3 total = half3(0.0, 0.0, 0.0);
+    float3 normal = normalize(normalIn);
+    for (int i = 0; i < LIGHTS; i++)
+    {
+        float4 place = uLights[i * 3];
+        float4 colour = uLights[i * 3 + 1];
+        float4 cone = uLights[i * 3 + 2];
+        float3 delta = place.xyz - world;
+        float index = floor(dot(delta, delta) * 4093.0 / (place.w * place.w) + 0.5);
+        float v = sqrt((min(index, 4095.0) + 1.0) / 4096.0);
+        float falloff = (index >= 4096.0) ? 0.0 : 1.0 + 2.0 * v * v * v - 3.0 * v * v;
+        float3 direction = normalize(delta);
+        float attenuation = falloff * abs(dot(direction, normal));
+        if (cone.w < 1.0)
+        {
+            float cosine = dot(direction, cone.xyz);
+            float spot = max(cosine - cone.w, 0.0) / (1.0 - cone.w);
+            attenuation *= spot * spot;
+        }
+        total += (half3)(colour.rgb * attenuation);
+    }
+    return total;
+}
+#endif
+
+float4 main(
+    float2 vUV : TEXCOORD0,
+    float2 vLightUV : TEXCOORD1,
+    half3 vFog : TEXCOORD2,
+    half4 vColor : COLOR,
+#if LIGHTS > 0
+    float3 vWorld : TEXCOORD3,
+    float3 vNormal : TEXCOORD4,
+#endif
+    uniform sampler2D uTexture : TEXUNIT0,
+    uniform sampler2D uLightmap : TEXUNIT1) : COLOR
+{
+#if DETAIL
+    return float4(lerp(vColor.rgb, (half3)tex2D(uTexture, vUV).rgb, vColor.a), 1.0);
+#elif FOGPASS
+    return tex2D(uLightmap, vLightUV);
+#else
+    half4 tint = (half4)uTint;
+#if FULLBRIGHT
+    half4 color = half4(tint.rgb, vColor.a * tint.a);
+#else
+    half4 color = vColor * tint;
+#endif
+    half4 texel = half4(1.0, 1.0, 1.0, 1.0);
+#if TEXTURED
+    texel = (half4)tex2D(uTexture, vUV);
+    color *= texel;
+#endif
+#if ALPHA_TEST
+    if (color.a < 0.5)
+    {
+        discard;
+    }
+#endif
+#if LIGHTS > 0
+    half3 dynamic = dynamicLight(vWorld, vNormal);
+#else
+    half3 dynamic = half3(0.0, 0.0, 0.0);
+#endif
+#if LIGHTMAP
+    color.rgb *= min((half3)tex2D(uLightmap, vLightUV).rgb + dynamic, half3(0.99608, 0.99608, 0.99608)) * 2.0;
+#elif LIGHTS > 0
+    color.rgb += texel.rgb * tint.rgb * dynamic * 2.0;
+#endif
+    return float4(saturate(color.rgb + vFog), color.a);
+#endif
+}
+)";
+
+        enum ExtraLocation { L_Lights = 0, L_Forward, L_Detail, L_Unused };
+
+        GLuint compileCg(GLenum type, const std::string& source, int32_t key)
+        {
+            GLuint shader = glCreateShader(type);
+            const char* text = source.c_str();
+            GLint length = static_cast<GLint>(source.size());
+            glShaderSource(shader, 1, &text, &length);
+            glCompileShader(shader);
+            GLint ok = 0;
+            glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+            if (!ok) {
+                char log[2048] = {};
+                glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+                std::fprintf(stderr, "Vita shader %s for key 0x%x failed to compile:\n%s\n", type == GL_CG_VERTEX_SHADER_EXT ? "vertex" : "fragment", static_cast<unsigned>(key), log);
+            }
+            return shader;
+        }
+
+        std::string defines(int32_t key)
+        {
+            int32_t lights = (key >> KeyLightShift) & 15;
+            char text[256];
+            std::snprintf(text, sizeof(text),
+                "#define TEXTURED %d\n#define LIGHTMAP %d\n#define ALPHA_TEST %d\n#define DETAIL %d\n#define FOGPASS %d\n#define FULLBRIGHT %d\n#define CLIP %d\n#define LIGHTS %d\n",
+                (key & SHADER_Textured) ? 1 : 0, (key & SHADER_Lightmap) ? 1 : 0, (key & SHADER_AlphaTest) ? 1 : 0, (key & SHADER_Detail) ? 1 : 0,
+                (key & SHADER_Fog) ? 1 : 0, (key & SHADER_Fullbright) ? 1 : 0, (key & KeyClip) ? 1 : 0, lights);
+            return text;
+        }
+    }
+
+    UberShader::UberShader()
+    {
+        glGenBuffers(1, &uploadBuffer);
+        for (int i = 0; i < 6; i++) {
+            glEnableVertexAttribArray(static_cast<GLuint>(i));
+        }
+        std::memset(viewProj, 0, sizeof(viewProj));
+        viewProj[0] = viewProj[5] = viewProj[10] = viewProj[15] = 1;
+        program(0);
+    }
+
+    UberShader::~UberShader()
+    {
+        for (auto& [key, entry] : cache) {
+            glDeleteProgram(entry->id);
+            delete entry;
+        }
+        glDeleteBuffers(1, &uploadBuffer);
+    }
+
+    UberShader::Program& UberShader::program(int32_t key)
+    {
+        for (auto& [cached, entry] : cache) {
+            if (cached == key) {
+                return *entry;
+            }
+        }
+        std::string head = defines(key);
+        GLuint vertex = compileCg(GL_CG_VERTEX_SHADER_EXT, head + vertexCg, key);
+        GLuint fragment = compileCg(GL_CG_FRAGMENT_SHADER_EXT, head + fragmentCg, key);
+        GLuint id = glCreateProgram();
+        glAttachShader(id, vertex);
+        glAttachShader(id, fragment);
+        const char* names[6] = { "aPosition", "aUV", "aLightUV", "aColor", "aNormal", "aFog" };
+        for (GLuint i = 0; i < 6; i++) {
+            glBindAttribLocation(id, i, names[i]);
+        }
+        glLinkProgram(id);
+        glDeleteShader(vertex);
+        glDeleteShader(fragment);
+        GLint ok = 0;
+        glGetProgramiv(id, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            std::fprintf(stderr, "Vita shader key 0x%x failed to link\n", static_cast<unsigned>(key));
+        }
+        Program* entry = new Program;
+        entry->id = id;
+        entry->loc[F_ViewProj] = glGetUniformLocation(id, "uViewProj");
+        entry->loc[F_Pan] = glGetUniformLocation(id, "uPan");
+        entry->loc[F_Scale] = glGetUniformLocation(id, "uScale");
+        entry->loc[F_Tint] = glGetUniformLocation(id, "uTint");
+        entry->loc[F_Lights] = glGetUniformLocation(id, "uLights");
+        entry->loc[F_Eye] = glGetUniformLocation(id, "uEye");
+        entry->loc[F_Clip] = glGetUniformLocation(id, "uClipPlanes");
+        entry->loc[F_Count + L_Forward] = glGetUniformLocation(id, "uForward");
+        entry->lightCount = (key >> KeyLightShift) & 15;
+        for (uint32_t& seen : entry->seen) {
+            seen = 0xffffffffu;
+        }
+        cache.emplace_back(key, entry);
+        std::printf("Vita shader 0x%03x ready (%u built)\n", static_cast<unsigned>(key), static_cast<unsigned>(cache.size()));
+        return *entry;
+    }
+
+    void UberShader::apply()
+    {
+        int32_t key = flags & (SHADER_Textured | SHADER_Lightmap | SHADER_AlphaTest | SHADER_Detail | SHADER_Fog | SHADER_Fullbright);
+        if (clipCount > 0) {
+            key |= KeyClip;
+        }
+        if ((flags & SHADER_Dynamic) && lightCount > 0 && !(flags & (SHADER_Detail | SHADER_Fog))) {
+            key |= lightCount << KeyLightShift;
+        }
+        Program& p = program(key);
+        if (active != &p) {
+            active = &p;
+            glUseProgram(p.id);
+        }
+        if (p.seen[F_ViewProj] != gen[F_ViewProj]) {
+            glUniformMatrix4fv(p.loc[F_ViewProj], 1, GL_FALSE, viewProj);
+            p.seen[F_ViewProj] = gen[F_ViewProj];
+        }
+        if (p.seen[F_Pan] != gen[F_Pan]) {
+            glUniform2fv(p.loc[F_Pan], 1, pan);
+            p.seen[F_Pan] = gen[F_Pan];
+        }
+        if (p.seen[F_Scale] != gen[F_Scale]) {
+            glUniform2fv(p.loc[F_Scale], 1, scale);
+            p.seen[F_Scale] = gen[F_Scale];
+        }
+        if (p.seen[F_Tint] != gen[F_Tint]) {
+            glUniform4fv(p.loc[F_Tint], 1, tint);
+            p.seen[F_Tint] = gen[F_Tint];
+        }
+        if (p.lightCount > 0 && p.seen[F_Lights] != gen[F_Lights]) {
+            glUniform4fv(p.loc[F_Lights], p.lightCount * 3, lights);
+            p.seen[F_Lights] = gen[F_Lights];
+        }
+        if ((key & SHADER_Detail) && p.seen[F_Eye] != gen[F_Eye]) {
+            forward[3] = detailDistance;
+            glUniform4fv(p.loc[F_Eye], 1, eye);
+            glUniform4fv(p.loc[F_Count + L_Forward], 1, forward);
+            p.seen[F_Eye] = gen[F_Eye];
+        }
+        if ((key & KeyClip) && p.seen[F_Clip] != gen[F_Clip]) {
+            glUniform4fv(p.loc[F_Clip], 8, clipPlanes);
+            p.seen[F_Clip] = gen[F_Clip];
+        }
+    }
+
+    void UberShader::pointers(const uint8_t* base)
+    {
+        auto at = [base](size_t offset) { return static_cast<const void*>(base + offset); };
+        GLsizei stride = sizeof(GLVertex);
+        glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, stride, at(offsetof(GLVertex, x)));
+        glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, stride, at(offsetof(GLVertex, u)));
+        glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, stride, at(offsetof(GLVertex, lu)));
+        glVertexAttribPointer(3, 4, GL_FLOAT, GL_FALSE, stride, at(offsetof(GLVertex, r)));
+        glVertexAttribPointer(4, 3, GL_FLOAT, GL_FALSE, stride, at(offsetof(GLVertex, nx)));
+        glVertexAttribPointer(5, 3, GL_FLOAT, GL_FALSE, stride, at(offsetof(GLVertex, fogR)));
+    }
+
+    void UberShader::use()
+    {
+        active = nullptr;
+        apply();
+    }
