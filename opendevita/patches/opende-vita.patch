+    namespace {
+        // Packages read on demand keep their file open; a few at most, the
+        // most recently used first.
+        struct OpenFile {
+            std::string path;
+            std::FILE* file = nullptr;
+        };
+        std::vector<OpenFile>& openFiles()
+        {
+            static std::vector<OpenFile> files;
+            return files;
+        }
+
+        std::FILE* openPackageFile(const std::string& path)
+        {
+            std::vector<OpenFile>& files = openFiles();
+            for (size_t i = 0; i < files.size(); i++) {
+                if (files[i].path == path) {
+                    if (i != 0) {
+                        std::rotate(files.begin(), files.begin() + static_cast<std::ptrdiff_t>(i), files.begin() + static_cast<std::ptrdiff_t>(i) + 1);
+                    }
+                    return files[0].file;
+                }
+            }
+            std::FILE* file = std::fopen(path.c_str(), "rb");
+            if (!file) {
+                return nullptr;
+            }
+            if (files.size() >= 12) {
+                std::fclose(files.back().file);
+                files.pop_back();
+            }
+            files.insert(files.begin(), OpenFile { path, file });
+            return file;
+        }
+
+        bool keepPackagesInMemory()
+        {
+#ifdef __vita__
+            static const bool keep = std::getenv("DX_PACKAGE_RESIDENT") != nullptr;
+#else
+            static const bool keep = std::getenv("DX_PACKAGE_WINDOW") == nullptr;
+#endif
+            return keep;
+        }
+    }
