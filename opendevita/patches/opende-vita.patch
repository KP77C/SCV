diff --git a/src/core/prof.cc b/src/core/prof.cc
new file mode 100644
index 0000000..4dc213e
--- /dev/null
+++ b/src/core/prof.cc
@@ -0,0 +1,96 @@
+#include "core/prof.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+#ifdef __vita__
+#include <psp2/kernel/processmgr.h>
+#else
+#include <chrono>
+#endif
+
+namespace dx::prof {
+    namespace {
+        const char* const names[Count] = {
+            "other", "game (rest)", "drawing (rest)", "actor ticks", "physics", "movement", "scripts", "AI", "audio", "menus/UI",
+            "visibility", "sky", "level", "meshes", "mesh lights", "sprites", "translucent", "HUD/canvas", "GL calls", "water/fire textures",
+        };
+    }
+
+    bool enabled()
+    {
+#ifdef __vita__
+        // On unless opende_env.txt sets DX_PROF=0.
+        static const bool on = [] {
+            const char* value = std::getenv("DX_PROF");
+            return !value || value[0] != '0';
+        }();
+        return on;
+#else
+        static const bool on = std::getenv("DX_PROF") != nullptr;
+        return on;
+#endif
+    }
+
+    uint64_t nowMicros()
+    {
+#ifdef __vita__
+        return sceKernelGetProcessTimeWide();
+#else
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+#endif
+    }
+
+    double timerCostMicros()
+    {
+        uint64_t start = nowMicros();
+        uint64_t sink = 0;
+        for (int i = 0; i < 1000; i++) {
+            sink += nowMicros();
+        }
+        uint64_t elapsed = nowMicros() - start;
+        return sink ? static_cast<double>(elapsed) / 1000.0 : 0.0;
+    }
+
+    State& state()
+    {
+        static State s;
+        return s;
+    }
+
+    std::string report(uint32_t frames)
+    {
+        State& s = state();
+        uint64_t t = nowMicros();
+        s.total[s.current] += t - s.stamp;
+        s.stamp = t;
+        if (frames == 0) {
+            frames = 1;
+        }
+        int order[Count];
+        for (int i = 0; i < Count; i++) {
+            order[i] = i;
+        }
+        std::sort(order, order + Count, [&](int a, int b) { return s.total[a] > s.total[b]; });
