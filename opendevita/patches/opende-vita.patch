diff --git a/src/game/vita_pad.cc b/src/game/vita_pad.cc
new file mode 100644
index 0000000..d3ed127
--- /dev/null
+++ b/src/game/vita_pad.cc
@@ -0,0 +1,11 @@
+// PS Vita: vita-elf-create appends its import tables (a few KiB) to the end
+// of the code segment, so the gap before the data segment must be big
+// enough. build.sh measures the gap and, when it is too small, relinks with
+// VITA_TEXT_PAD bytes of padding here to push the data segment one 64 KiB
+// step further.
+#ifdef __vita__
+#ifndef VITA_TEXT_PAD
+#define VITA_TEXT_PAD 1
+#endif
+extern "C" __attribute__((used, section(".rodata.vitapad"))) const unsigned char dx_vita_pad[VITA_TEXT_PAD] = { 1 };
+#endif
diff --git a/src/game/vita_platform.cc b/src/game/vita_platform.cc
new file mode 100644
index 0000000..9e081c8
--- /dev/null
+++ b/src/game/vita_platform.cc
@@ -0,0 +1,203 @@
+#ifdef __vita__
+
+#include "game/vita_platform.h"
+#include "render/gl_device.h"
+#include "core/prof.h"
+
+#include <psp2/ctrl.h>
+#include <psp2/kernel/processmgr.h>
+#include <psp2/kernel/sysmem.h>
+#include <psp2/power.h>
+#include <psp2/touch.h>
+#include <vitaGL.h>
+
+#include <malloc.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+// Memory: the C/C++ heap (where the engine keeps packages, maps and objects)
+// gets most of the extended user budget (param.sfo ATTRIBUTE2=12). vitaGL
+// takes what is left for the GPU, then borrows from this heap if it runs out.
+extern "C" {
+int setenv(const char* name, const char* value, int overwrite);
+unsigned int _newlib_heap_size_user = 256 * 1024 * 1024;
+// UnrealScript calls nest deeply; the default 256 KiB main stack is too small.
+unsigned int sceUserMainThreadStackSize = 8 * 1024 * 1024;
+}
+
+namespace vita {
+    namespace {
+        constexpr const char* DataRoot = "ux0:data/DeusEx";
+
+        // NAME=value lines from ux0:data/DeusEx/opende_env.txt become
+        // environment variables (DX_LOOK_SPEED, DX_TEXTURE_SKIP, ...).
+        void readEnvironmentFile()
+        {
+            std::string path = std::string(DataRoot) + "/opende_env.txt";
+            FILE* file = std::fopen(path.c_str(), "r");
+            if (!file) {
+                return;
+            }
+            char line[512];
+            while (std::fgets(line, sizeof(line), file)) {
+                char* end = line + std::strlen(line);
+                while (end > line && (end[-1] == '\n' || end[-1] == '\r' || end[-1] == ' ')) {
+                    *--end = 0;
+                }
+                char* equals = std::strchr(line, '=');
+                if (line[0] == '#' || !equals) {
+                    continue;
+                }
+                *equals = 0;
+                setenv(line, equals + 1, 1);
+                std::printf("env %s=%s\n", line, equals + 1);
+            }
+            std::fclose(file);
+        }
+
+        float stick(uint8_t raw)
+        {
+            float value = (static_cast<float>(raw) - 127.5f) / 127.5f;
+            constexpr float dead = 0.18f;
+            if (std::fabs(value) < dead) {
+                return 0;
+            }
+            float sign = value < 0 ? -1.0f : 1.0f;
+            return sign * std::fmin((std::fabs(value) - dead) / (1.0f - dead), 1.0f);
+        }
+
+        uint64_t now()
+        {
+            return sceKernelGetProcessTimeWide();
+        }
+
+        struct Timing {
+            uint64_t frameStart = 0;
+            uint64_t tickDone = 0;
+            uint64_t renderDone = 0;
+            uint64_t windowStart = 0;
+            double tick = 0;
+            double render = 0;
+            double swap = 0;
+            double worst = 0;
+            int frames = 0;
+        } timing;
+    }
+
+    void initialize()
+    {
+        // Full speed: 444 MHz CPU (an overclock plugin can raise it further).
+        scePowerSetArmClockFrequency(444);
+        scePowerSetBusClockFrequency(222);
+        scePowerSetGpuClockFrequency(222);
+        scePowerSetGpuXbarClockFrequency(166);
+
+        std::string log = std::string(DataRoot) + "/opende_log.txt";
+        std::string previous = std::string(DataRoot) + "/opende_log_prev.txt";
+        std::remove(previous.c_str());
+        std::rename(log.c_str(), previous.c_str());
+        std::freopen(log.c_str(), "w", stdout);
+        std::freopen(log.c_str(), "a", stderr);
+        setvbuf(stdout, nullptr, _IOLBF, 0);
+        setvbuf(stderr, nullptr, _IONBF, 0);
+        std::printf("OpenDE for PS Vita\n");
+
+        setenv("DEUSEX_GAME_DATA", DataRoot, 0);
+        // Settings and saves: ux0:data/DeusEx/deusex/ (DeusEx.ini, User.ini, Save/).
+        setenv("XDG_DATA_HOME", DataRoot, 0);
+        setenv("HOME", DataRoot, 0);
+        readEnvironmentFile();
+
+        sceCtrlSetSamplingMode(SCE_CTRL_MODE_ANALOG_WIDE);
+        sceTouchSetSamplingState(SCE_TOUCH_PORT_FRONT, SCE_TOUCH_SAMPLING_STATE_START);
+
+        // vglInitExtended returns GL_FALSE when it did not have to fall back
+        // to another resolution, so its result is not an error code.
+        vglInitExtended(0, ScreenWidth, ScreenHeight, 8 * 1024 * 1024, SCE_GXM_MULTISAMPLE_NONE);
+        vglWaitVblankStart(std::getenv("DX_NO_VSYNC") ? GL_FALSE : GL_TRUE);
+        glViewport(0, 0, ScreenWidth, ScreenHeight);
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+        vglSwapBuffers(GL_FALSE);
+        std::printf("GPU ready: VRAM %u KiB free, GPU RAM %u KiB free\n", static_cast<unsigned>(vglMemFree(VGL_MEM_VRAM) / 1024), static_cast<unsigned>(vglMemFree(VGL_MEM_RAM) / 1024));
+        std::printf("profiler: %s, timer read %.2f us\n", dx::prof::enabled() ? "on" : "off", dx::prof::timerCostMicros());
+    }
+
+    void readPad(Pad& pad)
+    {
+        SceCtrlData data {};
+        sceCtrlPeekBufferPositive(0, &data, 1);
+        pad.buttons = data.buttons;
+        pad.lx = stick(data.lx);
+        pad.ly = stick(data.ly);
+        pad.rx = stick(data.rx);
+        pad.ry = stick(data.ry);
+        SceTouchData touch {};
+        sceTouchPeek(SCE_TOUCH_PORT_FRONT, &touch, 1);
+        pad.touch = touch.reportNum > 0;
+        if (pad.touch) {
+            // The front panel reports 1920x1088.
+            pad.tx = static_cast<float>(touch.report[0].x) * 0.5f;
+            pad.ty = static_cast<float>(touch.report[0].y) * 0.5f;
+        }
+    }
+
+    void swap()
+    {
+        vglSwapBuffers(GL_FALSE);
+    }
+
+    void mark(Mark point)
+    {
+        uint64_t t = now();
+        switch (point) {
+        case Mark::FrameStart:
+            timing.frameStart = t;
+            if (!timing.windowStart) {
+                timing.windowStart = t;
+            }
+            break;
+        case Mark::TickDone:
+            timing.tickDone = t;
+            break;
+        case Mark::RenderDone:
+            timing.renderDone = t;
+            break;
+        case Mark::SwapDone: {
+            double tick = static_cast<double>(timing.tickDone - timing.frameStart) / 1000.0;
+            double render = static_cast<double>(timing.renderDone - timing.tickDone) / 1000.0;
+            double swap = static_cast<double>(t - timing.renderDone) / 1000.0;
+            double frame = static_cast<double>(t - timing.frameStart) / 1000.0;
+            timing.tick += tick;
+            timing.render += render;
+            timing.swap += swap;
+            timing.worst = std::fmax(timing.worst, frame);
+            timing.frames++;
+            double window = static_cast<double>(t - timing.windowStart) / 1e6;
+            if (window >= 5.0) {
+                int n = timing.frames;
+                struct mallinfo heap = mallinfo();
+                SceKernelFreeMemorySizeInfo free {};
+                free.size = sizeof(free);
+                sceKernelGetFreeMemorySize(&free);
+                std::printf("speed: %.1f fps | per frame: game %.1f ms, drawing %.1f ms, GPU wait+swap %.1f ms, worst frame %.0f ms | %u draws, %u texture binds | heap used %d MiB | VRAM free %u MiB, GPU RAM free %u MiB, system free %d MiB\n",
+                    n / window, timing.tick / n, timing.render / n, timing.swap / n, timing.worst,
+                    dx::drawStats.draws / static_cast<unsigned>(n), dx::drawStats.textures / static_cast<unsigned>(n),
+                    heap.uordblks / (1024 * 1024), static_cast<unsigned>(vglMemFree(VGL_MEM_VRAM) / (1024 * 1024)), static_cast<unsigned>(vglMemFree(VGL_MEM_RAM) / (1024 * 1024)),
+                    free.size_user / (1024 * 1024));
+                std::printf("%s\n", dx::prof::report(static_cast<uint32_t>(n)).c_str());
+                timing = Timing {};
+                timing.windowStart = t;
+                dx::drawStats = dx::DrawStats {};
+            }
+            break;
+        }
+        }
+    }
+}
+
+#endif
diff --git a/src/game/vita_platform.h b/src/game/vita_platform.h
new file mode 100644
index 0000000..7aa2a1c
--- /dev/null
+++ b/src/game/vita_platform.h
@@ -0,0 +1,35 @@
+// PS Vita platform layer for the game executable: start-up (clocks, GPU,
+// files, log), screen size and buffer swap, controller state, and a
+// once-every-few-seconds speed and memory line in the log.
+#pragma once
+#ifdef __vita__
+
+#include <cstdint>
+
+namespace vita {
+    constexpr int ScreenWidth = 960;
+    constexpr int ScreenHeight = 544;
+
+    struct Pad {
+        uint32_t buttons = 0;  // SCE_CTRL_* bits
+        float lx = 0;          // sticks, -1..1 after the dead zone
+        float ly = 0;
+        float rx = 0;
+        float ry = 0;
+        bool touch = false;    // a finger on the front screen
+        float tx = 0;          // its position in screen pixels
+        float ty = 0;
+    };
+
+    // Before anything else: clocks, log file, environment knobs, GPU.
+    void initialize();
+    void readPad(Pad& pad);
+    void swap();
+
+    // Frame timing: call mark() at the given points of each frame; a summary
+    // goes to the log every 5 seconds.
+    enum class Mark { FrameStart, TickDone, RenderDone, SwapDone };
+    void mark(Mark point);
+}
+
+#endif
